SECRET_KEY=django-insecure-change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
INSURANCE_CRYPTO_KEY=replace-with-a-strong-insurance-api-key
# 不填则本地开发不启用保险接口 API Key 鉴权；生产建议配置强随机值。
INSURANCE_API_KEY=
# 是否启用保险接口随机 token 鉴权；启用后需先调用 /api/insurance/auth/token/ 获取 token。
INSURANCE_TOKEN_AUTH_ENABLED=True
# token 有效期，单位秒，默认 7200 秒。
INSURANCE_TOKEN_TTL=7200

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=baoxian

REDIS_URL=redis://127.0.0.1:6379/1
CACHE_TIMEOUT=86400
CACHE_KEY_PREFIX=aitesthub
INSURANCE_DETAIL_CACHE_TIMEOUT=86400
